# Port the API listens on
PORT=4000
# Path to the service account JSON downloaded from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Origin of the React app allowed to call this API (comma separated for several)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://testing-firebase-notification.onrender.com/api/send-notification
